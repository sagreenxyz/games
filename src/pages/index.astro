---
import Layout from '../layouts/Layout.astro';
import { games } from '../data/games';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const families = [
  { id: 'meld', label: 'Rummy family' },
  { id: 'trick', label: 'Trick-taking' },
  { id: 'shedding', label: 'Shedding' },
  { id: 'betting', label: 'Betting' },
  { id: 'solitaire', label: 'Solo' },
];
---
<Layout title="Home">
  <section class="home">
    <h1>🎮 Games Library</h1>
    <p class="muted home-sub">Pick a game, invite friends, and play — no account needed.</p>
    {families.map(f => {
      const list = games.filter(g => g.family === f.id);
      return list.length > 0 && (
        <>
          <h2 class="family-title">{f.label}</h2>
          <div class="game-grid">
            {list.map(g => (
              <a href={`${base}/${g.slug}`} class="game-card">
                <div class="game-emoji">{g.emoji}</div>
                <h3>{g.name}</h3>
                <p>{g.blurb}</p>
                <div class="row wrap mt-1">
                  <span class="badge badge-gold">{g.players}</span>
                  <span class="badge badge-green">{g.mode === 'solo' ? 'Solo' : 'Human only'}</span>
                </div>
              </a>
            ))}
          </div>
        </>
      );
    })}
  </section>
</Layout>
