---
import GameRoom from '../../components/GameRoom.astro';
---
<GameRoom slug="gin" extra={['rummy-core.js']}>
  <Fragment slot="rules">
    <ul>
      <li>Each player gets 10 cards. Make <strong>melds</strong>: sets (3–4 of a rank) or runs (3+ in a row, same suit, Ace low).</li>
      <li>On your turn draw from the stock or take the top discard, then discard one card.</li>
      <li>Cards not in melds are <strong>deadwood</strong> (A=1, faces=10). <strong>Knock</strong> when your deadwood is 10 or less; deadwood 0 is <strong>gin</strong>.</li>
      <li>After a knock the other player lays off cards on your melds. Lower deadwood wins the difference; an undercut scores +25, gin +25, big gin +31.</li>
      <li>First to 100 wins the match.</li>
    </ul>
  </Fragment>

  <section id="gameTable" class="hidden">
    <div class="top-bar">
      <span id="roundLabel" class="label"></span>
      <span id="scoreLabel" class="small"></span>
      <span class="room">Room: <strong id="tableRoomCode"></strong></span>
      <button id="btnLeaveGame" class="btn btn-sm btn-danger">Leave</button>
    </div>
    <div class="game-layout">
      <div class="game-main">
        <div id="opponentsRow" class="opp-grid"></div>

        <div class="panel felt">
          <div class="row" style="justify-content:center;gap:2rem;">
            <div class="pile">
              <button id="stockPile" class="pile-btn" aria-label="Draw from the stock"></button>
              <span id="stockCount"></span>
            </div>
            <div class="pile">
              <button id="discardPile" class="pile-btn" aria-label="Take the top discard"></button>
              <span>Discard</span>
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="row wrap mb-1">
            <span id="myNameLabel" style="font-weight:700;font-size:1.1rem;"></span>
            <span id="deadwoodLabel" class="badge badge-gray"></span>
            <label class="row small" style="margin:0 0 0 auto;">Sort
              <select id="sortMode" style="width:auto;padding:.2rem .4rem;">
                <option value="melds">Melds first</option>
                <option value="suit">By suit</option>
                <option value="rank">By rank</option>
              </select>
            </label>
          </div>
          <div id="myCards" class="hand-row"></div>
        </div>

        <div class="panel">
          <div id="actionMessage" class="msg mb-1"></div>
          <div class="row wrap">
            <button id="btnTake" class="btn btn-success hidden">Take upcard</button>
            <button id="btnPass" class="btn btn-outline hidden">Pass</button>
            <button id="btnStock" class="btn btn-outline hidden">Draw from stock</button>
            <button id="btnDiscard" class="btn btn-primary hidden" disabled>Discard</button>
            <button id="btnKnock" class="btn btn-danger hidden" disabled>Knock</button>
            <button id="btnBigGin" class="btn btn-success hidden">Big Gin!</button>
          </div>
        </div>
      </div>
      <aside class="side-log">
        <h3>📜 Action Log</h3>
        <div id="actionLogList" class="log-list"></div>
      </aside>
    </div>
  </section>

  <div id="handModal" class="modal hidden">
    <div class="modal-box">
      <h2 id="handTitle"></h2>
      <div id="handDetails" style="text-align:left;"></div>
      <div class="row wrap mt-2" style="justify-content:center;">
        <button id="btnNextHand" class="btn btn-primary hidden">Next hand</button>
        <button id="btnNewMatch" class="btn btn-primary hidden">New match</button>
        <button id="btnLeaveAfter" class="btn btn-outline">← Leave</button>
      </div>
      <div id="handWaitMsg" class="muted small mt-1 hidden">Waiting for the host…</div>
    </div>
  </div>
</GameRoom>
