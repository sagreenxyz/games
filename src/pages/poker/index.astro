---
import GameRoom from '../../components/GameRoom.astro';
---
<GameRoom slug="poker">
  <Fragment slot="rules">
    <ul>
      <li>Everyone starts with 1,000 chips. Blinds are 10 / 20 and the button moves each hand.</li>
      <li>Make the best five-card hand from your two cards and the five community cards.</li>
      <li><strong>Raise by</strong> is the amount on top of the call. Raising by your whole stack is all-in.</li>
      <li>All-in players can only win what they matched; the rest goes to side pots.</li>
    </ul>
  </Fragment>

  <section id="gameTable" class="hidden">
    <div class="top-bar">
      <span id="roundLabel" class="label"></span>
      <span id="phaseLabel" class="badge badge-gray"></span>
      <span class="room">Room: <strong id="tableRoomCode"></strong></span>
      <button id="btnLeaveGame" class="btn btn-sm btn-danger">Drop Out</button>
    </div>

    <div class="game-layout">
      <div class="game-main">
        <div id="opponentsRow" class="opp-grid"></div>

        <div class="panel felt text-center">
          <div class="muted small mb-1">COMMUNITY CARDS</div>
          <div id="communityCards" class="cards-row" style="justify-content:center;min-height:96px;">
            <span class="placeholder">Cards will appear here</span>
          </div>
          <div class="mt-1">
            Pot: <strong id="potDisplay" style="color:var(--gold);">0</strong> chips
            &nbsp;|&nbsp; Current bet: <strong id="currentBetDisplay" style="color:var(--gold);">0</strong>
          </div>
          <div id="handRankDisplay" class="muted small" style="min-height:1.2em;"></div>
        </div>

        <div class="panel">
          <div class="row wrap mb-1">
            <span id="myNameLabel" style="font-weight:700;font-size:1.1rem;"></span>
            <span id="myChipsLabel" class="chips"></span>
            <span id="myStatusBadge" style="margin-left:auto;"></span>
          </div>
          <div id="myCards" class="hand-row"><span class="placeholder">Your cards will appear here</span></div>
        </div>

        <div id="actionPanel" class="panel">
          <div id="turnIndicator" class="muted small mb-1" style="min-height:1.3em;"></div>
          <div id="actionButtons" class="row wrap">
            <button id="btnFold"  class="btn btn-danger"  disabled>Fold</button>
            <button id="btnCheck" class="btn btn-outline" disabled>Check</button>
            <button id="btnCall"  class="btn btn-success" disabled>Call</button>
            <div class="row">
              <button id="btnRaise" class="btn btn-primary" disabled>Raise by</button>
              <input id="raiseAmount" type="number" min="20" step="10" aria-label="Raise by amount" style="width:95px;" placeholder="raise by" />
            </div>
          </div>
          <div id="gameMessage" class="msg mt-1"></div>
        </div>
      </div>

      <aside id="actionLogPanel" class="side-log">
        <h3>📜 Action Log</h3>
        <div id="actionLogList" class="log-list"><span class="placeholder">Actions will appear here</span></div>
      </aside>
    </div>
  </section>

  <div id="roundOverModal" class="modal hidden">
    <div class="modal-box">
      <div style="font-size:2rem;">🏆</div>
      <h2 id="roundOverTitle">Round Over!</h2>
      <div id="roundOverWinner" class="mb-1"></div>
      <div id="roundOverHostControls" class="row wrap hidden" style="justify-content:center;">
        <button id="btnPlayAgain" class="btn btn-primary">🃏 Next Hand</button>
        <button id="btnLeaveAfterRound" class="btn btn-outline">← Leave</button>
      </div>
      <div id="roundOverGuestMsg" class="muted small hidden">Next hand starts shortly…</div>
    </div>
  </div>
</GameRoom>
