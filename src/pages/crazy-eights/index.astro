---
import GameRoom from '../../components/GameRoom.astro';
---
<GameRoom slug="crazy-eights">
  <Fragment slot="rules">
    <ul>
      <li>Deal: 7 cards each for 2 players, 5 for 3–6. Play a card that matches the top card's <strong>suit or rank</strong>.</li>
      <li><strong>Eights are wild</strong>: play one any time and name the suit the next player must follow.</li>
      <li>Can't play? Draw one card. If it fits you may play it, otherwise your turn ends.</li>
      <li>First to empty their hand scores everyone else's cards: 8 = 50, J/Q/K = 10, A = 1, others face value. First to 100 wins.</li>
    </ul>
  </Fragment>

  <section id="gameTable" class="hidden">
    <div class="top-bar">
      <span id="roundLabel" class="label"></span>
      <span id="turnLabel" class="small"></span>
      <span class="room">Room: <strong id="tableRoomCode"></strong></span>
      <button id="btnLeaveGame" class="btn btn-sm btn-danger">Leave</button>
    </div>
    <div class="game-layout">
      <div class="game-main">
        <div id="opponentsRow" class="opp-grid"></div>
        <div class="panel felt">
          <div class="row" style="justify-content:center;gap:2rem;">
            <div class="pile">
              <button id="stockPile" class="pile-btn" aria-label="Draw a card"></button>
              <span id="stockCount"></span>
            </div>
            <div class="pile">
              <div id="discardTop"></div>
              <span id="followLabel"></span>
            </div>
          </div>
        </div>
        <div class="panel">
          <div class="row wrap mb-1">
            <span id="myNameLabel" style="font-weight:700;font-size:1.1rem;"></span>
            <span id="myScore" class="badge badge-gray"></span>
          </div>
          <div id="myCards" class="hand-row"></div>
        </div>
        <div class="panel">
          <div id="actionMessage" class="msg mb-1"></div>
          <div class="row wrap">
            <button id="btnDraw" class="btn btn-outline hidden">Draw a card</button>
            <button id="btnPass" class="btn btn-outline hidden">Pass</button>
          </div>
          <div id="suitPicker" class="row wrap mt-1 hidden" role="group" aria-label="Name a suit">
            <span class="small">Name a suit:</span>
            <button class="btn btn-sm btn-outline" data-suit="♠">♠ Spades</button>
            <button class="btn btn-sm btn-outline" data-suit="♥" style="color:#ff8a8a;">♥ Hearts</button>
            <button class="btn btn-sm btn-outline" data-suit="♦" style="color:#ff8a8a;">♦ Diamonds</button>
            <button class="btn btn-sm btn-outline" data-suit="♣">♣ Clubs</button>
            <button id="btnCancelEight" class="btn btn-sm btn-outline">Cancel</button>
          </div>
        </div>
      </div>
      <aside class="side-log">
        <h3>📜 Action Log</h3>
        <div id="actionLogList" class="log-list"></div>
      </aside>
    </div>
  </section>

  <div id="handModal" class="modal hidden">
    <div class="modal-box">
      <h2 id="handTitle"></h2>
      <div id="handDetails"></div>
      <div class="row wrap mt-2" style="justify-content:center;">
        <button id="btnNextHand" class="btn btn-primary hidden">Next hand</button>
        <button id="btnNewMatch" class="btn btn-primary hidden">New match</button>
        <button id="btnLeaveAfter" class="btn btn-outline">← Leave</button>
      </div>
      <div id="handWaitMsg" class="muted small mt-1 hidden">Waiting for the host…</div>
    </div>
  </div>
</GameRoom>
