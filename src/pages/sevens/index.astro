---
import GameRoom from '../../components/GameRoom.astro';
---
<GameRoom slug="sevens">
  <Fragment slot="rules">
    <ol>
      <li>All 52 cards are dealt out. The player with 7♦ starts by playing it.</li>
      <li>Play a 7 to start a suit, or a card one rank above or below that suit's row (Ace low, King high).</li>
      <li>You must play if you can; pass only when you have no playable card.</li>
      <li>First to empty their hand wins. If someone leaves, their cards are shared out.</li>
    </ol>
  </Fragment>

  <section id="gameTable" class="hidden">
    <div class="top-bar">
      <span id="roundLabel" class="label"></span>
      <span id="turnIndicator" class="small"></span>
      <span class="room">Room: <strong id="tableRoomCode"></strong></span>
      <button id="btnLeaveGame" class="btn btn-sm btn-danger">Leave</button>
    </div>

    <div class="game-layout">
      <div class="game-main">
        <div class="panel felt">
          <div class="muted small text-center mb-1">BOARD — play cards to extend each suit's row</div>
          <div id="boardRows" style="display:flex;flex-direction:column;gap:.6rem;"></div>
        </div>

        <div id="opponentsRow" class="opp-grid"></div>

        <div class="panel">
          <div class="row wrap mb-1">
            <span id="myNameLabel" style="font-weight:700;font-size:1.1rem;"></span>
            <span id="myCardCount" class="muted small"></span>
            <span id="myStatusBadge" style="margin-left:auto;"></span>
          </div>
          <div id="myCards" class="hand-row"><span class="placeholder">Your cards will appear here</span></div>
        </div>

        <div id="actionPanel" class="panel">
          <div id="actionMessage" class="msg mb-1"></div>
          <div id="actionButtons" class="row wrap">
            <button id="btnPass" class="btn btn-outline" disabled>Pass</button>
            <button id="btnHint" class="btn btn-outline btn-sm" disabled>💡 Hint</button>
          </div>
        </div>
      </div>

      <aside id="actionLogPanel" class="side-log">
        <h3>📜 Action Log</h3>
        <div id="actionLogList" class="log-list"><span class="placeholder">Actions will appear here</span></div>
      </aside>
    </div>
  </section>

  <div id="gameOverModal" class="modal hidden">
    <div class="modal-box">
      <div style="font-size:2rem;">🏆</div>
      <h2 id="gameOverTitle">Game Over!</h2>
      <div id="gameOverResults" style="text-align:left;" class="mb-1"></div>
      <div class="row wrap" style="justify-content:center;">
        <button id="btnPlayAgain" class="btn btn-primary hidden">🃏 Play Again</button>
        <button id="btnLeaveAfterGame" class="btn btn-outline">← Leave</button>
      </div>
      <div id="gameOverGuestMsg" class="muted small hidden mt-1">Waiting for host to start a new game…</div>
    </div>
  </div>
</GameRoom>
